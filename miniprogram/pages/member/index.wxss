/* 结果码九宫格：只写布局，颜色字号全部走令牌 */
.grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: var(--sp-2);
}

.grid-item {
  width: 31%;
  margin: 0 3.5% var(--sp-2) 0;
  padding: var(--sp-3) 0;
  text-align: center;
  background: var(--c-brand-weak);
  border-radius: var(--r-md);
  font-size: var(--fs-md);
  color: var(--c-brand-dark);
  font-weight: var(--fw-medium);
}

.grid-item:nth-child(3n) {
  margin-right: 0;
}

.grid-item:active {
  background: #FFE4D6;
}
