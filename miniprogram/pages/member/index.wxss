.hint { font-size: 26rpx; color: #8a8a8a; line-height: 1.7; margin-top: 8rpx; }

.grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.grid-item {
  width: 30%;
  margin: 0 3% 16rpx 0;
  padding: 20rpx 0;
  text-align: center;
  background: #f2f7f3;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #146b34;
}
