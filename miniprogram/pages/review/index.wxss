/* 行内动作按钮：用组件层的 btn--sm 再加一点间距控制 */
.act-row {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding-top: var(--sp-2);
  border-top: var(--hairline) solid var(--c-divider);
  margin-top: var(--sp-2);
}

.act-row .btn--sm {
  margin-left: var(--sp-1);
}

.act-row .btn--sm.ok {
  background: var(--c-success-weak);
  color: var(--c-success);
}

.act-row .btn--sm.warn {
  background: var(--c-warning-weak);
  color: var(--c-warning);
}

.act-row .btn--sm.down {
  background: var(--c-danger-weak);
  color: var(--c-danger);
}
