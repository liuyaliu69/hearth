<view class="container">

  <view class="card" wx:if="{{loading}}">
    <view class="hint">加载中…</view>
  </view>

  <view class="card" wx:elif="{{error}}">
    <view class="card-title t-danger">出错了</view>
    <view class="code">{{error}}</view>
    <view class="btn mt-2" bindtap="load">重试</view>
  </view>

  <block wx:else>
    <view class="card">
      <view class="card-title">{{user.name || user.staffName || '已登录'}}</view>
      <view class="row">
        <text class="label">角色</text>
        <text class="value">{{roleText || '—'}}</text>
      </view>
      <view class="row">
        <text class="label">员工</text>
        <text class="value">{{user.staffName || '未绑定'}}</text>
      </view>
    </view>

    <view class="notice notice--danger mb-2" wx:if="{{needMobile}}">
      员工资料里没有手机号。补上之后，老板或接替你的老师才能联系到你。
    </view>

    <view class="card">
      <view class="entry" bindtap="onGoHealth">
        <view class="entry__main">
          <view class="entry__title">诊断</view>
          <view class="entry__desc">看后端与数据库是否正常</view>
        </view>
        <view class="entry__arrow">›</view>
      </view>
      <view class="entry" bindtap="onLogout">
        <view class="entry__main">
          <view class="entry__title">退出登录</view>
          <view class="entry__desc">清掉本机登录态</view>
        </view>
        <view class="entry__arrow">›</view>
      </view>
    </view>
  </block>

</view>
