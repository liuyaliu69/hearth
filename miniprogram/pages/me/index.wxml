<view class="container">

  <view class="card" wx:if="{{loading}}">
    <view class="card-title">正在登录…</view>
  </view>

  <view class="card" wx:elif="{{error}}">
    <view class="card-title down">出错了</view>
    <view class="code">{{error}}</view>
    <view class="btn" bindtap="load">重试</view>
  </view>

  <block wx:else>
    <view class="card">
      <view class="card-title">{{user.name || user.staffName || '已登录'}}</view>
      <view class="row">
        <text class="label">角色</text>
        <text class="value">{{roleText || '—'}}</text>
      </view>
    </view>

    <view class="card" wx:if="{{needMobile}}">
      <view class="card-title down">还差一个手机号</view>
      <view class="hint">员工资料里没有手机号，补上之后老板才能联系到你</view>
    </view>

    <view class="card" wx:if="{{stats}}">
      <view class="card-title">今天</view>
      <view class="row">
        <text class="label">待跟进</text>
        <text class="value">{{stats.total}} 人</text>
      </view>
      <view class="row">
        <text class="label">已跟进</text>
        <text class="value">{{stats.done}} 人</text>
      </view>
      <view class="row" wx:if="{{isOwner}}">
        <text class="label">待核实</text>
        <text class="value down">{{stats.pendingReview}} 条</text>
      </view>
    </view>

    <view class="btn" bindtap="onTasks">今日待办</view>
    <view class="btn" wx:if="{{isOwner}}" bindtap="onReview">核实工作台</view>

    <view class="btn btn-ghost" bindtap="onGoHealth">诊断页</view>
    <view class="btn btn-ghost" bindtap="onLogout">退出登录</view>
  </block>

</view>
