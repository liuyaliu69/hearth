/* ============================================================
 * ① 令牌层 —— 全站唯一的数值来源
 *
 * 规则：任何 wxss 里都不许出现颜色字面量、字号字面量、间距字面量。
 *       要改风格，只改这个文件。
 * ============================================================ */

page {
  /* ---------- 品牌 ---------- */
  --c-brand: #FF6B35;          /* 火花橙：暖、有活力，和「FireDance」对得上 */
  --c-brand-dark: #E8551F;
  --c-brand-weak: #FFF2EC;

  /* ---------- 文字 ---------- */
  --c-text: #1A1A1A;
  --c-text-2: #5C6066;         /* 次要说明 */
  --c-text-3: #9AA0A6;         /* 弱化/占位 */
  --c-text-inverse: #FFFFFF;

  /* ---------- 背景与分割 ---------- */
  --c-bg: #F4F5F7;             /* 页面底：比纯白灰一点，白块才立得起来 */
  --c-surface: #FFFFFF;
  --c-fill: #F7F8FA;           /* 浅填充块（代码块、openid） */
  --c-divider: #F0F1F3;
  --c-border: #E4E6E9;
  --c-brand-press: #FFE4D6;    /* 品牌色浅块按下态 */

  /* ---------- 语义 ---------- */
  --c-success: #12B76A;
  --c-warning: #F79009;
  --c-danger: #F04438;
  --c-info: #2E90FA;

  /* ---------- 语义底色（标签用） ---------- */
  --c-success-weak: #E9F8F0;
  --c-warning-weak: #FFF6E5;
  --c-danger-weak: #FEECEB;
  --c-info-weak: #EAF3FE;

  /* 浅底上的深色文字（对比度足够，不用纯语义色） */
  --c-warning-text: #8A5A00;
  --c-danger-text: #9B2C24;

  /* ---------- 间距（4 的倍数） ---------- */
  --sp-1: 8rpx;
  --sp-2: 16rpx;
  --sp-3: 24rpx;
  --sp-4: 32rpx;
  --sp-5: 48rpx;
  --sp-6: 64rpx;

  /* ---------- 字号 ---------- */
  --fs-xs: 22rpx;              /* 标签、脚注 */
  --fs-sm: 26rpx;              /* 辅助说明 */
  --fs-md: 30rpx;              /* 正文 */
  --fs-lg: 34rpx;              /* 小标题 */
  --fs-xl: 40rpx;              /* 页面标题 */
  --fs-2xl: 56rpx;             /* 大数字 */

  /* ---------- 字重 ---------- */
  --fw-normal: 400;
  --fw-medium: 500;
  --fw-bold: 600;

  /* ---------- 圆角 ---------- */
  --r-sm: 8rpx;
  --r-md: 16rpx;
  --r-lg: 24rpx;
  --r-pill: 999rpx;

  /* ---------- 阴影（克制：只用很浅的一层） ---------- */
  --shadow-card: 0 1rpx 4rpx rgba(16, 24, 40, 0.04);
  --shadow-float: 0 8rpx 24rpx rgba(16, 24, 40, 0.12);

  /* ---------- 线宽 ---------- */
  --hairline: 1rpx;

  /* ---------- 安全区 ---------- */
  --safe-bottom: env(safe-area-inset-bottom);
}
