page {
  background: #f7f7f7;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #1f1f1f;
}

.container {
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.row:last-child {
  border-bottom: none;
}

.label {
  color: #8a8a8a;
}

.value {
  color: #1f1f1f;
  word-break: break-all;
  text-align: right;
  max-width: 60%;
}

.ok {
  color: #07c160;
}

.down {
  color: #fa5151;
}

.code {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
  color: #333;
}

.btn {
  background: #07c160;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
  margin-top: 8rpx;
}

.btn-ghost {
  background: #f2f2f2;
  color: #333333;
}
