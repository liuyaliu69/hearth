[Unit]
Description=Hearth Platform API (火花私域)
After=network.target mysqld.service
Wants=mysqld.service

[Service]
Type=simple
User=hearth
Group=hearth
WorkingDirectory=/opt/hearth
EnvironmentFile=/opt/hearth/db.env
EnvironmentFile=/opt/hearth/app.env

# 内存是关键约束：这台机器可用仅约 1350 MB（MySQL 已占 1.1 GB，小智占 636 MB）
# 320m 堆 + 128m metaspace 实测 RSS 约 500 MB，留 850 MB 余量
ExecStart=/usr/bin/java \
  -Xms96m -Xmx320m \
  -XX:MaxMetaspaceSize=128m \
  -XX:+ExitOnOutOfMemoryError \
  -Duser.timezone=Asia/Shanghai \
  -Dfile.encoding=UTF-8 \
  -jar /opt/hearth/app.jar \
  --spring.profiles.active=prod

Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/hearth

[Install]
WantedBy=multi-user.target
